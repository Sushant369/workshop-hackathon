# Create a copy of this file named `.env` and fill in real values.
# Never commit .env — it holds live credentials (.gitignore already excludes it).

NEO4J_URI="neo4j+s://<instance-id>.databases.neo4j.io"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="password"
NEO4J_DATABASE="neo4j"

# Chat-completions LLM (used for entity extraction). Any OpenAI-compatible
# endpoint works — point base_URL at a proxy, or leave it unset for the real
# OpenAI API.
OPENAI_API_KEY="your-chat-completions-api-key"
base_URL=""
MODEL_NAME="gpt-4o-mini"

# Embeddings — must be a real OpenAI key with billing enabled; used directly
# against api.openai.com (no base_URL override) for text-embedding-3-large.
OPENAI_EMBEDDINGS_MODEL_KEY="your-openai-api-key-with-billing"
openai_embeddings_model="text-embedding-3-large"
